# "production" turns on the strict checks: https FRONTEND_URL and Redis are
# required, and the fake-data mocks below can't be enabled.
NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Emailed links (invite, password reset) point here. Must be https in production.
FRONTEND_URL=http://localhost:3000

# Optional NestJS Observe telemetry (https://observe.nestjs.com). Off unless both keys are set.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=cailyx-backend

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_HOURS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Discovery / company-context module
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=replace-with-an-openrouter-api-key
AEO_LLM_MODEL=deepseek/deepseek-v4.1-flash
DATAFORSEO_LOGIN=replace-with-a-dataforseo-login
DATAFORSEO_PASSWORD=replace-with-a-dataforseo-password
# Deliberate kill switch: DataForSEO calls (paid) are disabled unless this is "1".
SWARM_ALLOW_LIVE=0
PRESENCE_SERP_MAX_QUERIES=20
# Per-run crawl budgets (optional; these are the pipeline's own defaults).
# A run pauses and continues in a new job when DISCOVERY_MAX_ELAPSED_MS is hit,
# so raising it only changes how much work one job does, not the total.
DISCOVERY_MAX_PAGES=12
DISCOVERY_MAX_REQUESTS=40
DISCOVERY_MAX_CHARS=24000
DISCOVERY_MAX_ELAPSED_MS=300000
DISCOVERY_MAX_RETRIES_PER_PAGE=2

# Technical Audit module
PSI_API_KEY=replace-with-a-pagespeed-insights-api-key
# Set to "false" to skip the is-agentic CLI scan path and use the read-only API fallback only.
AGENT_READINESS_CLI=true
AGENT_READINESS_TIMEOUT_MS=180000
TECHNICAL_AUDIT_PAGE_CRAWL_BUDGET=150
TECHNICAL_AUDIT_PAGE_CRAWL_CONCURRENCY=6
TECHNICAL_AUDIT_MAX_COST_PER_RUN_USD=5.0

# Social Activity (digital presence) module
APIFY_API_KEY=replace-with-an-apify-api-key
# Optional CSV override of the pulled platform set (default: linkedin,instagram,facebook,x).
APIFY_PLATFORMS=linkedin,instagram,facebook,x
APIFY_POSTS_PER_PLATFORM=20
# Optional JSON actor-map override, same escape hatch as the old module.
APIFY_ACTORS=
SOCIAL_WINDOW_DAYS=30
SOCIAL_MAX_COST_PER_RUN_USD=5.0

# Measurement module (SOP-2) — Cloro (cloro.dev) answer-engine surfaces
CLORO_API_KEY=replace-with-a-cloro-api-key
# Multi-account fallback: CLORO_API_KEY1, CLORO_API_KEY2, ... also read.
CLORO_CREDIT_USD=0.0004
CLORO_MAX_CONCURRENCY=1
MEASUREMENT_MAX_COST_PER_RUN=5.0
# Test-only deterministic surface. Never set to "1" in prod.
MEASUREMENT_ALLOW_MOCK=0

# AEO Audit module — audit-wide ceiling across every surface x market run plus stance plus narrative.
AEO_MAX_COST_PER_AUDIT=10.0

# Day-1 pipeline orchestrator (see docs/analysis/day1-pipeline.md).
# CSV answer-engine surfaces for the automatic Day-1 AEO audit.
DAY1_SURFACES=cloro_chatgpt
# How often the orchestrator polls its queued stages (ms). Optional.
#DAY1_POLL_INTERVAL_MS=20000

# Google module (Search Console + Analytics, see docs/analysis/google.md).
# Unset → honest 503/404, nothing attempted. Token key must be 32 random
# bytes as hex (openssl rand -hex 32); the OAuth redirect URI must also be
# registered in the Google Cloud Console or the flow 400s.
GOOGLE_CLIENT_ID=replace-with-a-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-hex

# Email module (Plunk transactional sender, see docs/analysis/email.md).
# Unset → EmailService throws an honest 503 and nothing is sent.
PLUNK_SECRET_KEY=replace-with-a-plunk-secret-key
PLUNK_SENDER_EMAIL=noreply@rothenhall.com
# Optional: display name in the inbox (default "Cailyx").
PLUNK_SENDER_NAME=Cailyx

# DataForSEO (scheduled-data) module (see docs/analysis/dataforseo.md).
# Mock-only build: the only adapter is the deterministic mock, gated behind
# DATAFORSEO_ALLOW_MOCK (same pattern as MEASUREMENT_ALLOW_MOCK). Live
# DataForSEO is NOT wired — SWARM_ALLOW_LIVE stays 0 and no credit is spent.
DATAFORSEO_ALLOW_MOCK=0
DATAFORSEO_MAX_COST_PER_RUN_USD=5.0
