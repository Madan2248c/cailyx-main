// Prisma schema for the auth/login module.
// See docs/analysis/auth.md for the full design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CLIENT_POC
  CLIENT_MEMBER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  INITIAL_INVITE
  RESEND_INVITE
  PASSWORD_RESET
}

model Client {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  status    ClientStatus @default(ACTIVE)
  seatLimit Int          @default(1) @map("seat_limit")
  createdBy String?      @map("created_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator      User?               @relation("ClientCreatedBy", fields: [createdBy], references: [id])
  users        User[]              @relation("ClientUsers")
  featureFlags ClientFeatureFlag[]
  projects     Project[]

  @@map("clients")
}

model Project {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @map("client_id") @db.Uuid
  name      String
  domain    String
  createdBy String? @map("created_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  client  Client @relation(fields: [clientId], references: [id])
  creator User?  @relation("ProjectCreatedBy", fields: [createdBy], references: [id])

  discoveryRuns          DiscoveryRun[]
  discoveredPages        DiscoveredPage[]
  socialProfiles         SocialProfile[]
  companyContextProfiles CompanyContextProfile[]
  technicalAuditRuns     TechnicalAuditRun[]
  auditPages             AuditPage[]
  technicalAuditSchedule TechnicalAuditSchedule?
  socialActivityRuns     SocialActivityRun[]
  socialPosts            SocialPost[]
  socialActivitySchedule SocialActivitySchedule?
  querySets              QuerySet[]
  measurementRuns        MeasurementRun[]
  aeoAudits              AeoAudit[]
  competitors            Competitor[]
  gapAnalysisRuns        GapAnalysisRun[]
  competitorProfiles     CompetitorProfile[]
  reports                Report[]
  day1PipelineRun        Day1PipelineRun?
  remediationRuns        RemediationRun[]
  fixSpecs               FixSpec[]

  // (clientId, domain) WHERE deleted_at IS NULL is a partial unique index,
  // added in the follow-up migration. Plain index here just backs lookups.
  @@index([clientId, domain])
  @@map("projects")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  role         Role
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  permission Permission @relation(fields: [permissionId], references: [id])

  // Uniqueness on (role, permissionId) WHERE deleted_at IS NULL is added as a
  // partial index in the follow-up hand-written migration (Prisma's schema
  // DSL can't express partial unique indexes). This plain index just backs
  // lookups.
  @@index([role, permissionId])
  @@map("role_permissions")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String
  passwordHash   String?    @map("password_hash")
  role           Role
  clientId       String?    @map("client_id") @db.Uuid
  status         UserStatus @default(INVITED)
  invitedBy      String?    @map("invited_by") @db.Uuid
  failedAttempts Int        @default(0) @map("failed_attempts")
  lockedUntil    DateTime?  @map("locked_until")
  lastLoginAt    DateTime?  @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  client              Client?             @relation("ClientUsers", fields: [clientId], references: [id])
  inviter             User?               @relation("UserInvitedBy", fields: [invitedBy], references: [id])
  invitedUsers        User[]              @relation("UserInvitedBy")
  createdClients      Client[]            @relation("ClientCreatedBy")
  updatedFeatureFlags ClientFeatureFlag[] @relation("FeatureFlagUpdatedBy")
  authTokens          AuthToken[]         @relation("AuthTokenUser")
  createdAuthTokens   AuthToken[]         @relation("AuthTokenCreatedBy")
  refreshTokens       RefreshToken[]
  createdProjects     Project[]           @relation("ProjectCreatedBy")

  // email uniqueness WHERE deleted_at IS NULL, and the "one active POC per
  // client" rule, are both added as partial indexes in the follow-up
  // migration. Plain indexes here just back lookups.
  @@index([email])
  @@index([clientId])
  @@map("users")
}

model ClientFeatureFlag {
  id         String  @id @default(uuid()) @db.Uuid
  clientId   String  @map("client_id") @db.Uuid
  featureKey String  @map("feature_key")
  enabled    Boolean @default(true)
  updatedBy  String? @map("updated_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  client  Client @relation(fields: [clientId], references: [id])
  updater User?  @relation("FeatureFlagUpdatedBy", fields: [updatedBy], references: [id])

  // (clientId, featureKey) WHERE deleted_at IS NULL is a partial index,
  // added in the follow-up migration.
  @@index([clientId, featureKey])
  @@map("client_feature_flags")
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  tokenHash  String        @map("token_hash")
  type       AuthTokenType
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdBy  String?       @map("created_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user    User  @relation("AuthTokenUser", fields: [userId], references: [id])
  creator User? @relation("AuthTokenCreatedBy", fields: [createdBy], references: [id])

  // tokenHash uniqueness WHERE deleted_at IS NULL is a partial index, added
  // in the follow-up migration.
  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user       User           @relation(fields: [userId], references: [id])
  replacedBy RefreshToken?  @relation("RefreshTokenChain", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("RefreshTokenChain")

  // tokenHash uniqueness WHERE deleted_at IS NULL is a partial index, added
  // in the follow-up migration.
  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// --- Discovery / company-context module ---
// See docs/analysis/discovery.md for the full design rationale. These 4
// tables are deliberately append-only/history tables (no deletedAt) — a
// stale fact is marked `status: stale` inside profile_json, and a new
// discovery_runs/company_context_profiles row supersedes the old one.

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETE
  COMPLETE_WITH_GAPS
  MANUAL_REVIEW_REQUIRED
  FAILED
}

enum DiscoveryStage {
  DISCOVER
  INSPECT
  SELECT
  EXTRACT
  RECONCILE
  VALIDATE
  SOCIAL_DISCOVERY
  EXTERNAL_ENRICH
  CONSOLIDATE
  GAP_RESEARCH
  SYNTHESIZE
  VERIFY
  COMPILE
}

enum PageType {
  HOMEPAGE
  SERVICE
  PRICING
  ABOUT
  INDUSTRIES
  LOCATION
  CASE_STUDY
  LEADERSHIP
  SECURITY
  PRESS
  CAREERS
  PARTNER
  BLOG
  OTHER
  CART
  LOGIN
  POLICY
}

enum PageFetchStatus {
  PENDING
  FETCHED
  FAILED
  EXCLUDED
}

enum ProfileDiscoveryMethod {
  SAMEAS
  LINK_SCAN
  SERP
}

enum SocialVerificationStatus {
  VERIFIED
  PROBABLE
  POSSIBLE
  REJECTED
}

model DiscoveryRun {
  id        String             @id @default(uuid()) @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  status    DiscoveryRunStatus @default(QUEUED)
  stage     DiscoveryStage?

  pagesSpent    Int @default(0) @map("pages_spent")
  requestsSpent Int @default(0) @map("requests_spent")
  charsSpent    Int @default(0) @map("chars_spent")
  elapsedMs     Int @default(0) @map("elapsed_ms")

  overallConfidence   Float?  @map("overall_confidence")
  overallCompleteness Float?  @map("overall_completeness")
  profileVersion      Int     @default(1) @map("profile_version")
  error               String?
  notes               Json    @default("[]")
  /// The run's in-flight pipeline state — reconciled/validated facts, category
  /// summaries, coverage plan, search usage/cost. A re-enqueued job resumes at
  /// `stage` from this instead of re-spending LLM/search calls (see
  /// docs/analysis/discovery.md "Job orchestration"). Deliberately a column,
  /// not a table — the module is capped at 4 tables.
  pipelineState       Json    @default("{}") @map("pipeline_state")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project  Project                 @relation(fields: [projectId], references: [id])
  pages    DiscoveredPage[]
  profiles CompanyContextProfile[]

  @@index([projectId])
  @@map("discovery_runs")
}

model DiscoveredPage {
  id                       String          @id @default(uuid()) @db.Uuid
  projectId                String          @map("project_id") @db.Uuid
  discoveryRunId           String          @map("discovery_run_id") @db.Uuid
  url                      String
  pageType                 PageType        @map("page_type")
  classificationConfidence Float?          @map("classification_confidence")
  priorityScore            Int?            @map("priority_score")
  fetchStatus              PageFetchStatus @default(PENDING) @map("fetch_status")
  cleanedText              String?         @map("cleaned_text")
  jsonLdRaw                String?         @map("json_ld_raw")
  contentHash              String?         @map("content_hash")
  /// Per-page pipeline state — the inspect output (title/description/headings/
  /// language) and this page's extracted facts plus their status, so the extract
  /// stage resumes without re-spending LLM calls on pages already done. See
  /// DiscoveryRun.pipelineState for why this is a column and not a table.
  pipelineState            Json            @default("{}") @map("pipeline_state")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id])
  discoveryRun DiscoveryRun @relation(fields: [discoveryRunId], references: [id])

  @@index([projectId])
  @@index([discoveryRunId])
  @@index([url])
  @@map("discovered_pages")
}

model SocialProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  projectId          String                   @map("project_id") @db.Uuid
  platform           String
  url                String
  discoveryMethod    ProfileDiscoveryMethod   @map("discovery_method")
  score              Int?
  verificationStatus SocialVerificationStatus @map("verification_status")
  verifiedAt         DateTime?                @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([platform])
  @@map("social_profiles")
}

model CompanyContextProfile {
  id                  String @id @default(uuid()) @db.Uuid
  projectId           String @map("project_id") @db.Uuid
  discoveryRunId      String @map("discovery_run_id") @db.Uuid
  profileJson         Json   @map("profile_json")
  overallConfidence   Float  @map("overall_confidence")
  overallCompleteness Float  @map("overall_completeness")
  version             Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project      Project      @relation(fields: [projectId], references: [id])
  discoveryRun DiscoveryRun @relation(fields: [discoveryRunId], references: [id])
  querySets    QuerySet[]

  @@index([projectId])
  @@index([discoveryRunId])
  @@map("company_context_profiles")
}

// --- Technical Audit module ---
// See docs/analysis/technical-audit.md for the full design. Crawl-based
// technical/SEO checks: robots.txt, CDN/bot-block probing, JS-render
// dependency, Core Web Vitals (PSI), schema.org analysis, sitemap analysis,
// agent-readiness (is-agentic), per-page SEO issues, a composite score, and
// run-over-run deltas. 3 tables, append-only (no deleted_at — same
// reasoning as Discovery's tables: a schedule being off is `active: false`,
// never a delete, and a run is never edited after it completes).

enum TechnicalAuditStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum AuditTrigger {
  MANUAL
  SCHEDULED
}

enum AuditCadence {
  WEEKLY
  MONTHLY
  MANUAL_ONLY
}

model TechnicalAuditRun {
  id              String               @id @default(uuid()) @db.Uuid
  projectId       String               @map("project_id") @db.Uuid
  status          TechnicalAuditStatus @default(QUEUED)
  triggeredBy     AuditTrigger         @map("triggered_by")
  /// The run this one is diffed against — resolved *before* this row is
  /// created (most recent sibling run with a non-null score), so the chain
  /// is unambiguous even with overlapping runs. Null on a project's first
  /// scored audit.
  previousAuditId String?              @map("previous_audit_id") @db.Uuid
  /// 0-100 composite, renormalized over whichever check components actually
  /// ran (see docs/analysis/technical-audit.md "Composite score"). Null
  /// until compile, or if nothing scoreable ran at all.
  score           Int?
  /// robots/cdn/js-render/cwv/schema/sitemap/agent-readiness analyses + page
  /// metadata + observability — one blob, same pattern as
  /// company_context_profiles.profile_json.
  result          Json                 @default("{}")
  /// Normalized AuditFinding[] — one entry per check, `status: error` for a
  /// check that threw rather than aborting the whole run.
  findings        Json                 @default("[]")
  /// Computed once at compile time against previousAuditId, never
  /// recomputed later even if the referenced previous run's own data changes.
  deltas          Json                 @default("[]")
  narrative       String?
  narrativeModel  String?              @map("narrative_model")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project       Project             @relation(fields: [projectId], references: [id])
  previousAudit TechnicalAuditRun?  @relation("AuditChain", fields: [previousAuditId], references: [id])
  succeededBy   TechnicalAuditRun[] @relation("AuditChain")
  pages         AuditPage[]
  gapAnalysisRuns GapAnalysisRun[]
  reports         Report[]

  @@index([projectId])
  @@index([previousAuditId])
  @@map("technical_audit_runs")
}

model AuditPage {
  id                  String @id @default(uuid()) @db.Uuid
  technicalAuditRunId String @map("technical_audit_run_id") @db.Uuid
  /// Denormalized, same pattern as discovered_pages — backs project-scoped
  /// queries without a join through the run.
  projectId           String @map("project_id") @db.Uuid
  url                 String
  statusCode          Int    @map("status_code")
  /// 0-100 from the SEO rubric, after the cross-page duplicate-content pass
  /// re-scores it (see "SEO rubric" — duplicate-content is a two-pass design).
  score               Int
  /// PageIssueCode[] — a real column (not buried in `signals`) because
  /// "worst pages" and per-issue-code filtering both sort/filter on it.
  issues              Json   @default("[]")
  /// title/meta/h1/canonical/word-count/image-counts/jsonLd — detail nothing
  /// queries independently, so it stays one blob.
  signals             Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  technicalAuditRun TechnicalAuditRun @relation(fields: [technicalAuditRunId], references: [id])
  project           Project           @relation(fields: [projectId], references: [id])

  @@index([technicalAuditRunId])
  @@index([projectId])
  @@index([url])
  @@map("audit_pages")
}

model TechnicalAuditSchedule {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @unique @map("project_id") @db.Uuid
  cadence   AuditCadence @default(MANUAL_ONLY)
  /// Off is `active: false`, never a delete. No `next_run_at` here — BullMQ's
  /// job scheduler tracks that; not duplicated in Postgres.
  active    Boolean      @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("technical_audit_schedules")
}

// --- Social Activity (digital presence) module ---
// See docs/analysis/digital-presence-audit.md for the full design. Audits a
// company's publishing activity across its verified social profiles (pulled
// via Apify actors): posts in a 30-day window, cadence aggregates, pattern
// buckets, dormant/infrequent findings. 3 tables, append-only (no deleted_at
// — same reasoning as Discovery's and Technical Audit's tables: a schedule
// being off is `active: false`, never a delete, and a run is never edited
// after it completes).

enum SocialActivityStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum SocialActivityTrigger {
  MANUAL
  SCHEDULED
}

enum SocialActivityCadence {
  WEEKLY
  MONTHLY
  MANUAL_ONLY
}

model SocialActivityRun {
  id             String               @id @default(uuid()) @db.Uuid
  projectId      String               @map("project_id") @db.Uuid
  status         SocialActivityStatus @default(QUEUED)
  triggeredBy    SocialActivityTrigger @map("triggered_by")
  /// The run this one is diffed against — resolved *before* this row is
  /// created (most recent sibling run with a non-null result), so the chain
  /// is unambiguous even with overlapping runs. Null on a project's first run.
  previousRunId  String?              @map("previous_run_id") @db.Uuid
  /// Platforms pulled, as-run. A subset of the social group when configured.
  platforms      String[]             @default([])
  postsPerPlatform Int                @default(20) @map("posts_per_platform")
  windowDays     Int                  @default(30) @map("window_days")
  /// Whether PROBABLE (not just VERIFIED) discovery rows were admitted as
  /// pull targets — recorded so a later reader knows the sample is softer.
  includeProbable Boolean             @default(false) @map("include_probable")
  /// Sum of per-platform actor spend (run-reported usageTotalUsd, else unit
  /// estimate — never presented as the billed figure).
  totalCostUsd   Float?               @map("total_cost_usd")
  /// Per-platform aggregates (cadence, buckets, engagement) — one blob, same
  /// pattern as technical_audit_runs.result.
  result         Json                 @default("{}")
  /// Normalized finding[] — one entry per platform, `status: error` for a
  /// platform whose actors threw rather than aborting the whole run.
  findings       Json                 @default("[]")
  /// Computed once at compile time against previousRunId, never recomputed
  /// later even if the referenced previous run's own data changes.
  deltas         Json                 @default("[]")
  narrative      String?
  narrativeModel String?              @map("narrative_model")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project      Project             @relation(fields: [projectId], references: [id])
  previousRun  SocialActivityRun?  @relation("SocialActivityChain", fields: [previousRunId], references: [id])
  succeededBy  SocialActivityRun[] @relation("SocialActivityChain")
  posts        SocialPost[]
  gapAnalysisRuns GapAnalysisRun[]
  reports         Report[]

  @@index([projectId])
  @@index([previousRunId])
  @@map("social_activity_runs")
}

model SocialPost {
  id                  String @id @default(uuid()) @db.Uuid
  socialActivityRunId String @map("social_activity_run_id") @db.Uuid
  /// Denormalized, same pattern as audit_pages — backs project-scoped
  /// queries without a join through the run.
  projectId           String @map("project_id") @db.Uuid
  platform            String
  /// 'profile' (account snapshot row) or 'post'.
  kind                String
  postedAt            DateTime? @map("posted_at")
  url                 String?
  caption             String?
  likeCount           Int? @map("like_count")
  commentCount        Int? @map("comment_count")
  shareCount          Int? @map("share_count")
  viewCount           Int? @map("view_count")
  followerCount       Int? @map("follower_count")
  followingCount      Int? @map("following_count")
  postCount           Int? @map("post_count")
  actorId             String @map("actor_id")
  /// Full raw actor item, so normalization can be re-run without re-spend.
  raw                 Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  run     SocialActivityRun @relation(fields: [socialActivityRunId], references: [id])
  project Project           @relation(fields: [projectId], references: [id])

  @@index([socialActivityRunId])
  @@index([projectId])
  @@index([platform])
  @@map("social_posts")
}

model SocialActivitySchedule {
  id        String               @id @default(uuid()) @db.Uuid
  projectId String               @unique @map("project_id") @db.Uuid
  cadence   SocialActivityCadence @default(MANUAL_ONLY)
  /// Off is `active: false`, never a delete. No `next_run_at` here — BullMQ's
  /// job scheduler tracks that; not duplicated in Postgres.
  active    Boolean              @default(true)
  /// Module-owned per-project config (plugin principle — not a boolean
  /// placeholder). Null/empty platforms means the env defaults.
  platforms        String[] @default([])
  windowDays       Int?     @map("window_days")
  postsPerPlatform Int?     @map("posts_per_platform")
  /// The scheduler fires nothing unless this is true — scheduled runs must
  /// never spend without opt-in.
  spendOptIn       Boolean  @default(false) @map("spend_opt_in")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@map("social_activity_schedules")
}

// --- Query Set module (SOP-1) ---
// See docs/analysis/query-set.md for the full design. A project's versioned
// prompt set, built in two LLM steps: propose per-project buckets grounded
// in Discovery's CompanyContextProfile, then generate prompts per bucket.
// Buckets are NOT a fixed taxonomy — invented per project, bounded by
// deterministic guardrails enforced in code. 3 tables, append-only (no
// deleted_at): a set is never edited in place once activated — fork() makes
// the next version, same pattern as Discovery's "never edited in place".

enum QuerySetStatus {
  draft
  active
  archived
}

enum QuerySetSource {
  manual
  sales_questions
  support_tickets
  llm_generated
}

/// Buyer-journey stage. Fixed taxonomy — independent of the business,
/// unlike the topic/angle buckets, and aggregated across projects by
/// measurement/reporting.
enum FunnelStage {
  problem_aware
  solution_aware
  product_aware
  most_aware
}

enum PromptBranding {
  branded
  unbranded
}

/// Persona the prompt is written from. Fixed alongside FunnelStage — see
/// docs/analysis/query-set.md "Decisions carried over from the old design".
enum PromptPersona {
  buyer
  researcher
  end_user
  evaluator
}

enum QuerySetItemGenerationMethod {
  llm_generated
  manual
}

model QuerySet {
  id        String         @id @default(uuid()) @db.Uuid
  projectId String         @map("project_id") @db.Uuid
  version   Int            @default(1)
  label     String?
  status    QuerySetStatus @default(draft)
  source    QuerySetSource @default(manual)
  /// Which Discovery profile this set was grounded on, for traceability.
  /// Null for manual sets.
  generationContextId String? @map("generation_context_id") @db.Uuid
  /// Target-size tier used for bucket sizing (e.g. starter/full). Null for
  /// manual sets.
  generationTier String? @map("generation_tier")

  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project           Project                @relation(fields: [projectId], references: [id])
  generationContext CompanyContextProfile? @relation(fields: [generationContextId], references: [id])
  buckets           QuerySetBucket[]
  items             QuerySetItem[]
  measurementRuns   MeasurementRun[]
  aeoAudits         AeoAudit[]

  @@index([projectId])
  @@index([generationContextId])
  @@map("query_sets")
}

model QuerySetBucket {
  id          String        @id @default(uuid()) @db.Uuid
  querySetId  String        @map("query_set_id") @db.Uuid
  /// LLM-invented slug, unique within the set (enforced in code, not a DB
  /// constraint — uniqueness is per-querySetId, not globally).
  name        String
  /// One sentence citing the specific context field that justifies this
  /// bucket — checked against the grounding CompanyContextProfile before
  /// generation spends budget on it. See the grounding-check guardrail.
  rationale   String
  persona     PromptPersona
  funnelStage FunnelStage    @map("funnel_stage")
  branding    PromptBranding
  /// Post-guardrail, scaled count actually used — not necessarily what the
  /// LLM proposed (see "Total set size" guardrail: overshoots scale down
  /// proportionally, never drop ad hoc).
  targetCount Int            @map("target_count")

  createdAt DateTime @default(now()) @map("created_at")

  querySet QuerySet       @relation(fields: [querySetId], references: [id])
  items    QuerySetItem[]

  @@index([querySetId])
  @@map("query_set_buckets")
}

model QuerySetItem {
  id       String  @id @default(uuid()) @db.Uuid
  querySetId String @map("query_set_id") @db.Uuid
  /// Null for manually-added items (no bucket to belong to).
  bucketId String? @map("bucket_id") @db.Uuid
  prompt   String
  /// Copied from the bucket at generation time — denormalized so a manual
  /// item can still be tagged without a bucket.
  funnelStage FunnelStage     @map("funnel_stage")
  /// Copied from the bucket; null for manual items unless tagged.
  branding    PromptBranding?
  generationMethod QuerySetItemGenerationMethod @map("generation_method")

  createdAt DateTime @default(now()) @map("created_at")

  querySet QuerySet        @relation(fields: [querySetId], references: [id])
  bucket   QuerySetBucket? @relation(fields: [bucketId], references: [id])
  observations Observation[]

  @@index([querySetId])
  @@index([bucketId])
  @@map("query_set_items")
}

// --- Measurement module (SOP-2) ---
// See backend/src/modules/measurement/README.md. Measures AI visibility:
// for every prompt in a project's ACTIVE query set, queries an AI answer
// surface via Cloro (cloro.dev — ChatGPT/Perplexity/Gemini/Google AI
// Overview/AI Mode through one API instead of a Playwright session) n
// times, and scores each answer into a structured Observation
// (mentioned/cited/position). Append-only, same pattern as every other
// pipeline module: a run is never edited after it completes.

enum MeasurementRunStatus {
  pending
  running
  completed
  failed
}

/// Cloro-backed answer-engine surfaces. `mock` is test-only, gated behind
/// MEASUREMENT_ALLOW_MOCK — never used in a real run.
enum MeasurementSurface {
  cloro_chatgpt
  cloro_perplexity
  cloro_gemini
  cloro_ai_overview
  cloro_ai_mode
  mock
}

model MeasurementRun {
  id         String               @id @default(uuid()) @db.Uuid
  projectId  String               @map("project_id") @db.Uuid
  querySetId String               @map("query_set_id") @db.Uuid
  surface    MeasurementSurface
  /// Country code, e.g. "US", "GB".
  geo        String               @default("US")
  /// Repeat count per prompt. Was a hard n>=5 floor in the old design;
  /// lowered to 1 minimum here on the same operator override the old repo
  /// recorded — a runCount:1 result is a single sample, not a rate, and
  /// callers must treat it accordingly.
  runCount   Int                  @default(1) @map("run_count")
  status     MeasurementRunStatus @default(pending)

  totalRequests     Int   @default(0) @map("total_requests")
  completedRequests Int   @default(0) @map("completed_requests")
  failedRequests    Int   @default(0) @map("failed_requests")
  costTotal         Float @default(0) @map("cost_total")
  error             String?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project      Project       @relation(fields: [projectId], references: [id])
  querySet     QuerySet      @relation(fields: [querySetId], references: [id])
  observations Observation[]
  aeoSurfaceRuns AeoSurfaceRun[]

  @@index([projectId])
  @@index([querySetId])
  @@map("measurement_runs")
}

model Observation {
  id        String @id @default(uuid()) @db.Uuid
  runId     String @map("run_id") @db.Uuid
  itemId    String @map("item_id") @db.Uuid
  runNumber Int    @map("run_number")
  /// Denormalized from the item at execution time — the prompt text used
  /// stays fixed even if the item is later removed from a still-draft set.
  prompt    String

  mentioned        Boolean
  cited            Boolean
  citedUrl         String? @map("cited_url")
  /// 1-based index among the surface's citations. Diagnostics only — never
  /// surfaced as a headline metric (rates, never positions).
  position         Int?
  characterization String

  rawAnswer String @map("raw_answer")
  costUsd   Float  @map("cost_usd")
  latencyMs Int    @map("latency_ms")
  model     String

  createdAt DateTime @default(now()) @map("created_at")

  run  MeasurementRun @relation(fields: [runId], references: [id])
  item QuerySetItem   @relation(fields: [itemId], references: [id])
  aeoStance AeoStance?

  @@index([runId])
  @@index([itemId])
  @@map("observations")
}

// --- AEO Audit module ---
// See backend/src/modules/aeo-audit/README.md. Ties an ACTIVE query set to
// one or more Measurement runs (one per surface x market), judges each
// resulting Observation's stance (a separate LLM call, distinct from
// Measurement's deterministic mentioned/cited scoring), and assembles a
// verdict: raw rate slices + plain-language headlines. No composite score —
// ported faithfully from the old repo, which computed none either (rates,
// never a single number). Never generates its own query set — consumes one
// Query Set already built, per the layering decision recorded there.

enum AeoAuditStatus {
  pending
  running
  completed
  failed
}

enum AeoSurfaceRunStatus {
  pending
  running
  completed
  failed
}

/// Distinct from Measurement's deterministic mentioned/cited/characterization
/// — this is the LLM's read of HOW the subject was positioned, not just
/// whether it appeared.
enum Stance {
  recommended_primary
  recommended_alternative
  mentioned_neutral
  mentioned_negative
  absent
}

enum CompetitorStatus {
  tracked
  candidate
}

enum CompetitorSource {
  manual
  stance_discovered
  /// A distinct domain that ranked in one of this project's bounded
  /// category-level SERP queries (competitors module) — never the client's
  /// own domain. Defaults to `candidate` status, same as stance_discovered,
  /// since ranking in a category search doesn't itself confirm a rivalry.
  serp_discovered
}

model AeoAudit {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @map("project_id") @db.Uuid
  querySetId String         @map("query_set_id") @db.Uuid
  surfaces   MeasurementSurface[]
  /// Country codes, e.g. ["US", "GB"]. Default single-market.
  markets    String[]       @default(["US"])
  status     AeoAuditStatus @default(pending)

  promptCount   Int   @default(0) @map("prompt_count")
  observations  Int   @default(0)
  stanceJudged  Int   @default(0) @map("stance_judged")
  /// Audit-wide spend across every surface x market measurement run plus
  /// stance plus narrative — a separate, wider ceiling than any one
  /// MeasurementRun's own MEASUREMENT_MAX_COST_PER_RUN.
  costUsd       Float @default(0) @map("cost_usd")
  error         String?
  /// {counted: SliceMetrics + shareOfVoice + competitorStanding, judged:
  /// stance counts + losing/winning prompts, headlines: string[], narrative?:
  /// string[]} — see aeo-audit.types.ts. Recomputable from stored rows at any
  /// time (GET .../verdict), so this is a cache, not the source of truth.
  verdict       Json  @default("{}")

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project     Project        @relation(fields: [projectId], references: [id])
  querySet    QuerySet       @relation(fields: [querySetId], references: [id])
  surfaceRuns AeoSurfaceRun[]
  stances     AeoStance[]
  gapAnalysisRuns GapAnalysisRun[]
  reports         Report[]

  @@index([projectId])
  @@index([querySetId])
  @@map("aeo_audits")
}

model AeoSurfaceRun {
  id                String              @id @default(uuid()) @db.Uuid
  auditId           String              @map("audit_id") @db.Uuid
  surface           MeasurementSurface
  market            String
  /// Set once the underlying MeasurementRun is created — null while pending.
  measurementRunId  String?             @map("measurement_run_id") @db.Uuid
  status            AeoSurfaceRunStatus @default(pending)
  observations      Int                 @default(0)
  stanceJudged      Int                 @default(0) @map("stance_judged")
  costUsd           Float               @default(0) @map("cost_usd")
  /// Typed reason for a failed surface — one surface failing never voids the
  /// audit as long as at least one other completes.
  failureKind       String?             @map("failure_kind")
  error             String?

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  audit          AeoAudit        @relation(fields: [auditId], references: [id])
  measurementRun MeasurementRun? @relation(fields: [measurementRunId], references: [id])

  @@unique([auditId, surface, market])
  @@index([auditId])
  @@map("aeo_surface_runs")
}

model AeoStance {
  id              String   @id @default(uuid()) @db.Uuid
  auditId         String   @map("audit_id") @db.Uuid
  observationId   String   @unique @map("observation_id") @db.Uuid
  surface         MeasurementSurface
  stance          Stance
  /// 1-based position among the brands the model named, or null when the
  /// subject wasn't ranked against anything. Diagnostics only, same rule as
  /// Observation.position — never a headline number.
  rankAmongBrands Int?     @map("rank_among_brands")
  brandsNamed     String[] @map("brands_named")
  /// Named rivals the subject placed above/below — filtered through the
  /// project's known Competitor list before being recorded here (an unknown
  /// name goes to otherNamesSeen instead, never guessed into a rivalry).
  recommendedOver String[] @map("recommended_over")
  losesTo         String[] @map("loses_to")
  /// Names the model used that matched no known competitor, non-competitor
  /// platform, or the subject's own brand — queued as Competitor(candidate)
  /// rows for an operator to confirm, never auto-promoted.
  otherNamesSeen  String[] @map("other_names_seen")
  evidenceQuote   String?  @map("evidence_quote")
  rationale       String?
  judgeModel      String   @map("judge_model")
  costUsd         Float    @map("cost_usd")

  createdAt DateTime @default(now()) @map("created_at")

  audit       AeoAudit    @relation(fields: [auditId], references: [id])
  observation Observation @relation(fields: [observationId], references: [id])

  @@index([auditId])
  @@map("aeo_stances")
}

/// Single source of truth for a project's known competitors — deliberately
/// NOT the old repo's design (a seed JSON column that never synced with a
/// separate candidates table). Every rival name stance judging is allowed
/// to attribute a rivalry to comes from here; every unrecognized name stance
/// judging sees becomes a `candidate` row here, confirmable by an operator.
model Competitor {
  id        String           @id @default(uuid()) @db.Uuid
  projectId String           @map("project_id") @db.Uuid
  name      String
  domain    String?
  status    CompetitorStatus @default(tracked)
  source    CompetitorSource @default(manual)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  profiles CompetitorProfile[]

  @@index([projectId])
  @@map("competitors")
}

// --- Gap Analysis module (SOP-5) ---
// See backend/src/modules/gap-analysis/README.md. The first and only place
// a recommendation gets generated in this pipeline: reads the latest
// completed run from Technical Audit, AEO Audit, and Social Activity via
// their own exported services (no cross-module DB reads), then one LLM
// call consolidates every finding into a ranked list of concrete next
// steps. No new taxonomy, no re-derived findings, no invented numbers —
// a deliberate departure from the old repo's rules-engine classifier.

enum GapAnalysisStatus {
  RUNNING
  COMPLETE
  FAILED
}

enum RecommendationStatus {
  OPEN
  DONE
  DISMISSED
}

model GapAnalysisRun {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  status    GapAnalysisStatus @default(RUNNING)
  /// Which source run of each kind was consolidated, if any — a project
  /// missing a completed run from one or more sources is not an error,
  /// just a narrower run (this column then stays null for that source).
  sourceTechnicalAuditRunId String? @map("source_technical_audit_run_id") @db.Uuid
  sourceSocialActivityRunId String? @map("source_social_activity_run_id") @db.Uuid
  sourceAeoAuditId          String? @map("source_aeo_audit_id") @db.Uuid
  error     String?

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  project             Project                    @relation(fields: [projectId], references: [id])
  sourceTechnicalAudit TechnicalAuditRun?        @relation(fields: [sourceTechnicalAuditRunId], references: [id])
  sourceSocialActivity SocialActivityRun?        @relation(fields: [sourceSocialActivityRunId], references: [id])
  sourceAeoAudit       AeoAudit?                 @relation(fields: [sourceAeoAuditId], references: [id])
  recommendations      GapAnalysisRecommendation[]
  reports              Report[]

  @@index([projectId])
  @@map("gap_analysis_runs")
}

model GapAnalysisRecommendation {
  id               String                @id @default(uuid()) @db.Uuid
  gapAnalysisRunId String                @map("gap_analysis_run_id") @db.Uuid
  title            String
  description      String
  /// Ordinal only, 1 = most influential. Never a fabricated numeric score.
  priorityRank     Int                   @map("priority_rank")
  /// [{ module: 'technical-audit'|'social-activity'|'aeo-audit', findingRef: string }]
  /// — the grounding citations, checked against the collected source data
  /// at generation time (a citation that doesn't exist is rejected before
  /// this row is ever created).
  sourceFindings   Json                  @default("[]") @map("source_findings")
  /// The one mutable field on this table — operator-tracked, never
  /// regenerated. A run is never edited after it completes; this is the
  /// deliberate exception, because staff need to record what's been done.
  status           RecommendationStatus  @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run GapAnalysisRun @relation(fields: [gapAnalysisRunId], references: [id])

  @@index([gapAnalysisRunId])
  @@map("gap_analysis_recommendations")
}

// --- Competitors module ---
// See backend/src/modules/competitors/README.md. Reuses AEO Audit's
// `Competitor` table as the single source of truth (never a second
// competitor list) — this module only adds a profile per competitor
// (tech stack, schema types, homepage SEO score on the same rubric the
// client is scored by, review rating) plus one more discovery path
// (serp_discovered, added to CompetitorSource above).

enum CompetitorProfileFetchStatus {
  OK
  FAILED
}

model CompetitorProfile {
  id           String  @id @default(uuid()) @db.Uuid
  /// Null represents the project's OWN domain's profile — same row shape
  /// used for both, so the gap comparison reads one table without a union.
  competitorId String? @map("competitor_id") @db.Uuid
  /// Set on every row, including the client's own, so a query never needs
  /// to join through a nullable competitorId.
  projectId    String  @map("project_id") @db.Uuid

  /// TechStackFinding[] — { category, name, evidence }.
  techStackFindings Json @default("[]") @map("tech_stack_findings")
  /// Distinct JSON-LD @type values found on the homepage.
  schemaTypes       Json @default("[]") @map("schema_types")
  /// 0-100, from Technical Audit's shared seo-rubric.ts — the same
  /// function the client's own Technical Audit runs use, not a
  /// re-implementation. Null if the fetch failed.
  seoScore          Int? @map("seo_score")
  /// PageIssueCode[] from the same rubric.
  seoIssues         Json @default("[]") @map("seo_issues")
  /// { source, rating, count } from a review-site AggregateRating, or null
  /// — no review-site URL is auto-discovered in v1 (see module README).
  reviewRating      Json? @map("review_rating")
  fetchStatus       CompetitorProfileFetchStatus @map("fetch_status")
  error             String?

  createdAt DateTime @default(now()) @map("created_at")

  competitor Competitor? @relation(fields: [competitorId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id])

  @@index([competitorId])
  @@index([projectId])
  @@map("competitor_profiles")
}

// --- Reporting module (SOP-11) ---
// See backend/src/modules/reporting/README.md. Assembles a report from the
// latest completed run of Technical Audit, Social Activity, AEO Audit,
// Competitors, and Gap Analysis (read-only, via each module's own exported
// service — a missing source is omitted, never fabricated, same discipline
// as Gap Analysis). One `kind` column (DAY1/MONTHLY), not two systems: both
// share this table, the render pipeline, and the share-link mechanism.
//
// Two independent axes, never derived from each other: `visibility`
// (public sharing) and `status` (editorial gate). DAY1 bypasses the
// editorial gate entirely (generates straight into RELEASED, per explicit
// operator decision — the first report a new client sees has had zero
// human review, traded for a fully automatic onboarding flow). MONTHLY
// keeps the full DRAFT -> IN_REVIEW -> RELEASED state machine.

enum ReportKind {
  DAY1
  MONTHLY
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  RELEASED
  WITHDRAWN
}

enum ReportVisibility {
  PRIVATE
  PUBLIC
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  projectId  String           @map("project_id") @db.Uuid
  kind       ReportKind
  slug       String           @unique
  status     ReportStatus     @default(DRAFT)
  visibility ReportVisibility @default(PRIVATE)
  title      String
  /// LLM-written, cited-numbers-only — same discipline as AEO Audit's
  /// narrative. Never invents a figure not already in a collected source.
  executiveSummary String  @map("executive_summary")
  /// MONTHLY only — the prior report this one diffs against. Null for
  /// DAY1 (this report IS the baseline) and for a project's first MONTHLY.
  previousReportId String? @map("previous_report_id") @db.Uuid

  sourceTechnicalAuditRunId String? @map("source_technical_audit_run_id") @db.Uuid
  sourceSocialActivityRunId String? @map("source_social_activity_run_id") @db.Uuid
  sourceAeoAuditId          String? @map("source_aeo_audit_id") @db.Uuid
  sourceGapAnalysisRunId    String? @map("source_gap_analysis_run_id") @db.Uuid

  /// Set once released — the revision a client actually sees. A report can
  /// be regenerated/re-reviewed after this without changing what's already
  /// been shown; only release moves this pointer.
  releasedRevisionId String? @unique @map("released_revision_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at")
  releasedAt DateTime? @map("released_at")

  project             Project              @relation(fields: [projectId], references: [id])
  previousReport       Report?             @relation("ReportChain", fields: [previousReportId], references: [id])
  succeededBy          Report[]            @relation("ReportChain")
  sourceTechnicalAudit TechnicalAuditRun?  @relation(fields: [sourceTechnicalAuditRunId], references: [id])
  sourceSocialActivity SocialActivityRun?  @relation(fields: [sourceSocialActivityRunId], references: [id])
  sourceAeoAudit       AeoAudit?           @relation(fields: [sourceAeoAuditId], references: [id])
  sourceGapAnalysisRun GapAnalysisRun?     @relation(fields: [sourceGapAnalysisRunId], references: [id])
  revisions            ReportRevision[]    @relation("ReportRevisions")
  releasedRevision     ReportRevision?     @relation("ReleasedRevision", fields: [releasedRevisionId], references: [id])
  shareLinks           ReportShareLink[]

  @@index([projectId])
  @@index([previousReportId])
  @@map("reports")
}

model ReportRevision {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  revisionNumber Int      @map("revision_number")
  /// The frozen, fully-rendered content as of this revision — what a
  /// client actually saw. Recomputing the report later never changes what
  /// an already-released revision shows.
  contentSnapshot Json    @default("{}") @map("content_snapshot")

  createdAt DateTime @default(now()) @map("created_at")

  report         Report  @relation("ReportRevisions", fields: [reportId], references: [id])
  releasedFor    Report? @relation("ReleasedRevision")

  @@unique([reportId, revisionNumber])
  @@index([reportId])
  @@map("report_revisions")
}

model ReportShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  reportId  String    @map("report_id") @db.Uuid
  token     String    @unique
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("report_share_links")
}

// --- Day-1 pipeline orchestrator ---
// See docs/analysis/day1-pipeline.md for the full design. One row per
// project: the automatic end-to-end run (discovery → technical-audit →
// social-activity → query-set → aeo-audit → competitors → gap-analysis →
// reporting DAY1 → ready email). A row is never edited after terminal —
// retries resume the same row, skipping recorded stages.

enum Day1PipelineStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model Day1PipelineRun {
  id         String            @id @default(uuid()) @db.Uuid
  projectId  String            @unique @map("project_id") @db.Uuid
  clientId   String            @map("client_id") @db.Uuid
  status     Day1PipelineStatus @default(QUEUED)
  /// Stage key the processor is working on (observability + resume cursor).
  currentStage String? @map("current_stage")
  /// Per-stage record: { [stage]: { status, runId?, error?, skippedReason? } }.
  stages Json @default("{}")
  /// Admin's optional Day-1 spend ceiling from project creation (null = uncapped).
  spendCeilingUsd Float? @map("spend_ceiling_usd")
  spendAuthorizedAt DateTime @map("spend_authorized_at")
  reportId String? @map("report_id") @db.Uuid
  error    String?
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([clientId])
  @@map("day1_pipeline_runs")
}

// --- Remediation ("Fix Plan") module ---
// See docs/analysis/remediation.md for the full design. Turns audit findings
// into tracked fix specs (evidence + generated fix + steps + a
// machine-checkable acceptance check) and proves fixes on the live site.
// `remediation_runs` and `fix_spec_events` are append-only; `fix_specs` is the
// one living record, upserted by fingerprint, because a real fix moves
// through stages. Source-run ids and the gap recommendation id are plain
// UUID columns (no FK) so this module adds no relation fields to other
// modules' models.

enum RemediationRunStatus {
  RUNNING
  COMPLETE
  FAILED
}

enum FixClass {
  CODE
  CONFIG
  CONTENT
  OFF_SITE
  INVESTIGATE
}

enum FixMethod {
  GENERATED
  LLM_DRAFT
  INSTRUCTIONS
  HUMAN
}

enum FixLevel {
  LOW
  MEDIUM
  HIGH
}

enum FixStatus {
  OPEN
  AWAITING_DECISION
  IN_PROGRESS
  APPLIED
  VERIFIED
  REGRESSED
  DISMISSED
}

enum FixDecision {
  APPROVED
  DECLINED
}

model RemediationRun {
  id                        String               @id @default(uuid()) @db.Uuid
  projectId                 String               @map("project_id") @db.Uuid
  status                    RemediationRunStatus @default(RUNNING)
  /// Which source run of each kind was read, if any.
  sourceTechnicalAuditRunId String?              @map("source_technical_audit_run_id") @db.Uuid
  sourceSocialActivityRunId String?              @map("source_social_activity_run_id") @db.Uuid
  sourceAeoAuditId          String?              @map("source_aeo_audit_id") @db.Uuid
  sourceGapAnalysisRunId    String?              @map("source_gap_analysis_run_id") @db.Uuid
  createdCount              Int                  @default(0) @map("created_count")
  updatedCount              Int                  @default(0) @map("updated_count")
  verifiedCount             Int                  @default(0) @map("verified_count")
  regressedCount            Int                  @default(0) @map("regressed_count")
  /// Guardrail drops: [{ problemKey, target, reason }].
  droppedDrafts             Json                 @default("[]") @map("dropped_drafts")
  triggeredBy               String?              @map("triggered_by") @db.Uuid
  error                     String?

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("remediation_runs")
}

model FixSpec {
  id                  String       @id @default(uuid()) @db.Uuid
  projectId           String       @map("project_id") @db.Uuid
  /// sha256(projectId | problemKey | target) — a re-sync updates, never duplicates.
  fingerprint         String       @unique
  /// e.g. robots.unblock-ai-crawlers, schema.organization-missing, page.meta-missing
  problemKey          String       @map("problem_key")
  /// Page URL, or the site origin for site-level problems.
  target              String
  fixClass            FixClass     @map("fix_class")
  method              FixMethod
  /// Batching key (one PR / one work session fixes a whole group).
  groupKey            String       @map("group_key")
  severity            FixLevel
  effort              FixLevel
  title               String
  /// What the audit observed (a copy, so the spec reads on its own).
  evidence            Json         @default("{}")
  /// The generated fix: { kind, path?, language?, placement?, content }. Null when none.
  artifact            Json?
  /// Why no artifact could be built when one was expected — never guessed.
  artifactError       String?      @map("artifact_error")
  /// string[] — numbered human steps, also agent context.
  steps               Json         @default("[]")
  /// AcceptanceCheck — the machine-checkable end state.
  acceptance          Json
  /// Latest LLM copy draft, on request only. A re-sync never overwrites it.
  llmDraft            Json?        @map("llm_draft")
  needsClientDecision Boolean      @default(false) @map("needs_client_decision")
  decision            FixDecision?
  decisionNote        String?      @map("decision_note")
  status              FixStatus    @default(OPEN)
  /// GapAnalysisRecommendation that cites the same finding (plain id, no FK).
  gapRecommendationId String?      @map("gap_recommendation_id") @db.Uuid
  prUrl               String?      @map("pr_url")
  dismissedReason     String?      @map("dismissed_reason")
  /// The newest source run that reported this problem.
  lastReportedAt      DateTime     @map("last_reported_at")
  lastVerifiedAt      DateTime?    @map("last_verified_at")
  lastVerifyResult    Json?        @map("last_verify_result")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id])
  sources FixSpecSource[]
  events  FixSpecEvent[]

  @@index([projectId, status])
  @@index([projectId, groupKey])
  @@map("fix_specs")
}

model FixSpecSource {
  id         String @id @default(uuid()) @db.Uuid
  fixSpecId  String @map("fix_spec_id") @db.Uuid
  /// 'technical-audit' | 'social-activity' | 'aeo-audit'
  module     String
  runId      String @map("run_id") @db.Uuid
  /// Same ref format Gap Analysis cites, e.g. 'robots', 'linkedin:dormant'.
  findingRef String @map("finding_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fixSpec FixSpec @relation(fields: [fixSpecId], references: [id], onDelete: Cascade)

  @@unique([fixSpecId, module, findingRef])
  @@map("fix_spec_sources")
}

model FixSpecEvent {
  id         String     @id @default(uuid()) @db.Uuid
  fixSpecId  String     @map("fix_spec_id") @db.Uuid
  /// 'status' | 'decision' | 'verify' | 'draft' | 'sync'
  kind       String
  fromStatus FixStatus? @map("from_status")
  toStatus   FixStatus? @map("to_status")
  /// user id | 'system'
  actor      String
  detail     Json       @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  fixSpec FixSpec @relation(fields: [fixSpecId], references: [id], onDelete: Cascade)

  @@index([fixSpecId])
  @@map("fix_spec_events")
}
